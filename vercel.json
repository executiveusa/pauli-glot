{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "env": {
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": {
      "description": "Clerk publishable key from https://dashboard.clerk.com"
    },
    "CLERK_SECRET_KEY": {
      "description": "Clerk secret key from https://dashboard.clerk.com"
    },
    "NEXT_PUBLIC_CLERK_SIGN_IN_URL": {
      "description": "Sign in URL",
      "default": "/sign-in"
    },
    "NEXT_PUBLIC_CLERK_SIGN_UP_URL": {
      "description": "Sign up URL",
      "default": "/sign-up"
    },
    "NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL": {
      "description": "URL after sign in",
      "default": "/dashboard"
    },
    "NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL": {
      "description": "URL after sign up",
      "default": "/dashboard"
    },
    "OPENAI_API_KEY": {
      "description": "OpenAI API key from https://platform.openai.com/api-keys"
    }
  }
}
